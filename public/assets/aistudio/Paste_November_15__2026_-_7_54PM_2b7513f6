}

/* --- MISI 3: HUTAN HARAPAN --- */
const M3_OPTS = [
  { id:'o1', t:'Pilihan A: Tutup Semua Kilang Serta-Merta', p:'Udara pulih pantas.', c:'Ramai pekerja hilang punca pendapatan.' },
  { id:'o2', t:'Pilihan B: Wajibkan Penapis Asap + Tanam Semula Hutan & Pengangkutan Hijau', p:'Mengawal punca pencemaran secara mampan.', c:'Perlukan kerjasama semua pihak.' },
  { id:'o3', t:'Pilihan C: Edar Topeng Muka Percuma Sahaja', p:'Murah dan mudah.', c:'Tidak menghapuskan punca pencemaran.' }
];
function renderMission3(c, user, back) {
  c.innerHTML = back + `<div class="card">
    <span class="tag tag-green">MISI 3 • MENILAI CADANGAN PENYELESAIAN</span>
    <h2 class="game-font" style="font-size:1.8rem;color:#15803d;margin-bottom:10px;">🌳 HUTAN HARAPAN</h2>
    <div class="grid-3" style="margin-bottom:16px;">
      ${M3_OPTS.map(o=>`<div style="background:#f8fafc;border:2px solid #cbd5e1;border-radius:16px;padding:14px;">
        <h4 class="game-font" style="color:#0f3d24;margin-bottom:6px;">${o.t}</h4>
        <p style="font-size:.82rem;color:#15803d;">✅ ${o.p}</p>
