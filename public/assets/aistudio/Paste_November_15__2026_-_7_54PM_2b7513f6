function submitMission2(e) {
  e.preventDefault();
  const match = (document.getElementById('m2-a').value==='ok'?50:0) + (document.getElementById('m2-b').value==='ok'?50:0);
  const punca = document.getElementById('m2-punca').value.trim(), kesan = document.getElementById('m2-kesan').value.trim();
  const kbat = document.getElementById('m2-kbat').value.trim();
  const kbatScore = kbat.length>=30 ? 90 : kbat.length>=15 ? 70 : 50;
  const total = Math.round((match + kbatScore)/2);

  const db = getDB(); const user = getCurrentUser(db); const first = !user.progress.m2.completed;
  user.progress.m2 = { completed:true, score:total, kbatScore, thinkingMap:{punca, kesan}, kbatAnswer:kbat };
  if (first) user.xp += 180;
  if (user.unlockedMission < 3) user.unlockedMission = 3;
