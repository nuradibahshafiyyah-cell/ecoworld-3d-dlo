}
function submitMission3(e) {
  e.preventDefault();
  const ch = document.getElementById('m3-c').value, j = document.getElementById('m3-j').value.trim();
  const total = (ch==='o2'?60:30) + (j.length>=25?40:20);
  const db = getDB(); const user = getCurrentUser(db); const first = !user.progress.m3.completed;
  user.progress.m3 = { completed:true, score:total, chosenOption:M3_OPTS.find(x=>x.id===ch).t, justification:j };
  if (first) user.xp += 180;
  if (user.unlockedMission < 4) user.unlockedMission = 4;
  evaluateBadges(user); addLog(db, user.fullName, `Menyelesaikan Misi 3 (${total}%)`); saveDB(db);
  playSFX('win'); showMissionCompleteModal(3, total, first?180:0, ch==='o2'?'Tepat! Penyelesaian mampan menjaga alam & ekonomi.':'Jawapan direkodkan. Pertimbangkan keseimbangan ekonomi & alam sekitar.');
}

/* --- MISI 4: MAKMAL SUARA (PEMBINA HUJAH & RAKAMAN MIKROFON) --- */
let mRec = null, aChunks = [];
function renderMission4(c, user, back) {
  const arg = user.progress.m4.argument || { pendirian:'', bukti:'', huraian:'', kesimpulan:'' };
  c.innerHTML = back + `<div class="card">
    <span class="tag tag-yellow">MISI 4 • MEMBINA HUJAH & BERTUTUR (SP 1.2.2)</span>
    <h2 class="game-font" style="font-size:1.8rem;color:#0f172a;margin-bottom:10px;">🎙️ MAKMAL SUARA</h2>
    <div style="background:#eff6ff;border:2px solid #38bdf8;border-radius:14px;padding:12px;margin-bottom:14px;font-size:.84rem;">
      <strong>🗣️ Panduan Bertutur:</strong> Sebutan baku jelas • Intonasi bersemangat pada isi penting • Gunakan penanda wacana (<em>Buktinya, Oleh itu, Tegasnya</em>).
    </div>
    <form onsubmit="submitMission4(event)">
      <div class="grid-2">
        <div class="form-group"><label>1. Pendirian</label><input id="m4-p" class="form-control" required value="${arg.pendirian}" placeholder="Saya berpendapat pencemaran di EcoWorld mesti dihentikan segera..."></div>
        <div class="form-group"><label>2. Bukti Tersurat & Tersirat</label><input id="m4-b" class="form-control" required value="${arg.bukti}" placeholder="Buktinya, laporan Pak Mail mendedahkan pembuangan sisa waktu malam..."></div>
        <div class="form-group"><label>3. Huraian Kritis & Cadangan</label><input id="m4-h" class="form-control" required value="${arg.huraian}" placeholder="Oleh itu, pemasangan penapis asap dan penguatkuasaan undang-undang..."></div>
        <div class="form-group"><label>4. Kesimpulan / Seruan</label><input id="m4-k" class="form-control" required value="${arg.kesimpulan}" placeholder="Tegasnya, marilah kita bersama-sama menyelamatkan bumi!"></div>
      </div>
      <div class="media-box">
        <strong class="game-font" style="color:#4ade80;">🎙️ Perakam Suara Hujah</strong>
        <p style="font-size:.82rem;color:#cbd5e1;margin:4px 0 10px;">Baca hujah di atas dengan suara yang jelas dan intonasi meyakinkan:</p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <button type="button" class="btn-game btn-sm btn-primary" id="rec-start" onclick="startRec()">🔴 Mula Rakam</button>
          <button type="button" class="btn-game btn-sm btn-danger" id="rec-stop" onclick="stopRec()" disabled>⏹ Henti</button>
          <span id="rec-msg" style="font-size:.82rem;color:#facc15;">Sedia</span>
        </div>
        <div id="rec-play" style="margin-top:10px;">${state.tempAudioUrl?`<audio controls src="${state.tempAudioUrl}" style="width:100%"></audio>`:''}</div>
      </div>
      <div class="form-group"><label>Semakan Kendiri / Rakan Sebaya:</label>
        <input id="m4-peer" class="form-control" value="${user.peerFeedback||''}" placeholder="Sebutan jelas dan intonasi saya semakin baik..."></div>
      <button type="submit" class="btn-game btn-gold">🎙️ Simpan Hujah & Buka Misi Akhir</button>
    </form>
  </div>`;
}
async function startRec() {
  try {
    const st = await navigator.mediaDevices.getUserMedia({ audio: true });
    mRec = new MediaRecorder(st); aChunks = [];
    mRec.ondataavailable = e => aChunks.push(e.data);
    mRec.onstop = () => {
      state.tempAudioUrl = URL.createObjectURL(new Blob(aChunks, { type:'audio/webm' }));
      document.getElementById('rec-play').innerHTML = `<audio controls src="${state.tempAudioUrl}" style="width:100%"></audio>`;
      st.getTracks().forEach(t=>t.stop());
    };
    mRec.start(); document.getElementById('rec-start').disabled=true; document.getElementById('rec-stop').disabled=false;
    document.getElementById('rec-msg').textContent = '🔴 Sedang merakam suara anda...';
  } catch(e) { toast('Mikrofon disekat/tiada. Anda masih boleh berlatih secara lisan.', true); }
}
function stopRec() { if(mRec && mRec.state!=='inactive'){ mRec.stop(); document.getElementById('rec-start').disabled=false; document.getElementById('rec-stop').disabled=true; document.getElementById('rec-msg').textContent='✅ Rakaman siap!'; } }
function submitMission4(e) {
  e.preventDefault();
  const arg = { pendirian:document.getElementById('m4-p').value, bukti:document.getElementById('m4-b').value, huraian:document.getElementById('m4-h').value, kesimpulan:document.getElementById('m4-k').value };
  const peer = document.getElementById('m4-peer').value, hasRec = Boolean(state.tempAudioUrl);
  const score = Math.min(100, 75 + (hasRec?15:5) + (peer.length>5?10:0));
  const db = getDB(); const user = getCurrentUser(db); const first = !user.progress.m4.completed;
  user.progress.m4 = { completed:true, score, argument:arg, hasRecording:hasRec||user.progress.m4.hasRecording }; user.peerFeedback = peer;
  if (first) user.xp += 220;
  if (user.unlockedMission < 5) user.unlockedMission = 5;
  evaluateBadges(user); addLog(db, user.fullName, `Menyiapkan Makmal Suara (${score}%)`); saveDB(db);
  playSFX('win'); showMissionCompleteModal(4, score, first?220:0, 'Hujah mantap! Misi Kemuncak PBL kini dibuka.');
}

