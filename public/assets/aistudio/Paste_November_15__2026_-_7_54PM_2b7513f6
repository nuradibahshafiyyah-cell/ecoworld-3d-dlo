let ctx = null;
function playSFX(type) {
  if (!soundOn || !AudioCtx) return;
  try {
    if (!ctx) ctx = new AudioCtx();
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    const now = ctx.currentTime;
    if (type === 'click') {
      o.type = 'sine'; o.frequency.setValueAtTime(520, now); o.frequency.exponentialRampToValueAtTime(760, now + 0.07);
      g.gain.setValueAtTime(0.08, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.08);
      o.start(now); o.stop(now + 0.08);
    } else if (type === 'xp') {
      o.type = 'triangle'; o.frequency.setValueAtTime(587, now); o.frequency.setValueAtTime(880, now + 0.09);
      g.gain.setValueAtTime(0.12, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
      o.start(now); o.stop(now + 0.25);
    } else if (type === 'win') {
      [523, 659, 784, 1046].forEach((freq, i) => {
        const osc = ctx.createOscillator(), gn = ctx.createGain();
        osc.type = 'triangle'; osc.connect(gn); gn.connect(ctx.destination);
        osc.frequency.setValueAtTime(freq, now + i * 0.1);
        gn.gain.setValueAtTime(0.12, now + i * 0.1); gn.gain.exponentialRampToValueAtTime(0.001, now + i * 0.1 + 0.35);
        osc.start(now + i * 0.1); osc.stop(now + i * 0.1 + 0.35);
      });
    } else if (type === 'error') {
      o.type = 'sawtooth'; o.frequency.setValueAtTime(220, now); o.frequency.linearRampToValueAtTime(140, now + 0.18);
      g.gain.setValueAtTime(0.08, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
      o.start(now); o.stop(now + 0.2);
    }
  } catch (e) {}
}

