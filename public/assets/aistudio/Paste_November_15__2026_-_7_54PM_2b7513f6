function collectM1Clue(k, text) {
  if (!state.m1Clues.includes(k)) { state.m1Clues.push(k); playSFX('xp'); toast('Bukti ditemui: ' + text); renderApp(); }
}
function playM1Audio() {
  if (!('speechSynthesis' in window)) return toast('Sila buka transkrip audio.', true);
  window.speechSynthesis.cancel();
  const u = new SpeechSynthesisUtterance(M1_SCRIPT); u.lang = 'ms-MY'; u.rate = 0.95;
  const w = document.getElementById('m1-waves');
  u.onstart = () => w && w.classList.add('playing'); u.onend = () => w && w.classList.remove('playing');
  window.speechSynthesis.speak(u); w && w.classList.add('playing');
}
function stopM1Audio() { window.speechSynthesis && window.speechSynthesis.cancel(); document.getElementById('m1-waves')?.classList.remove('playing'); }

function submitMission1(e) {
  e.preventDefault(); stopM1Audio();
  const q1 = document.getElementById('m1-q1').value, q2 = document.getElementById('m1-q2').value;
  const q3 = document.getElementById('m1-q3').value.toLowerCase(), ev = document.getElementById('m1-ev').value.trim();
  const tersurat = (q1==='b'?50:0) + (q2==='a'?50:0);
  const kw = ['sembunyi','tidur','kesan','tangkap','rahsia','elak','penguat','nampak','senyap'];
  const tersirat = (kw.some(k=>q3.includes(k)) && q3.length>15) ? 90 : q3.length>20 ? 70 : 40;
  const bonus = state.m1Clues.length >= 3 ? 10 : 0;
  const total = Math.min(100, Math.round((tersurat + tersirat)/2) + bonus);

  const db = getDB(); const user = getCurrentUser(db); const first = !user.progress.m1.completed;
  user.progress.m1 = { completed:true, score:total, tersuratScore:tersurat, tersiratScore:tersirat, evidence:Array.from(new Set([...user.progress.m1.evidence, ev])) };
  if (first) user.xp += 150;
  if (user.unlockedMission < 2) user.unlockedMission = 2;
  evaluateBadges(user); addLog(db, user.fullName, `Menyelesaikan Misi 1 (${total}%)`); saveDB(db);
  playSFX('win'); showMissionCompleteModal(1, total, first?150:0, `Tersurat: ${tersurat}% | Tersirat: ${tersirat}%. Bukti disimpan dalam Evidence Book!`);
}

