    recs.push('Dengar laporan Pak Mail untuk bezakan fakta tersurat dan tersirat.');
  } else {
    if (p.m1.tersiratScore < 70) {
      mode = 'Pengukuhan (Mendengar & Tersirat)';
      recs.push('Markah tersirat rendah (' + p.m1.tersiratScore + '%). Latihan Pengukuhan: Fokus pada sebab tersembunyi di sebalik tindakan pembuangan sisa waktu malam.');
    } else recs.push('Penguasaan maklumat tersirat cemerlang (' + p.m1.tersiratScore + '%).');
    if (p.m2.completed && p.m2.kbatScore < 70) {
      mode = 'Pengukuhan (Analisis KBAT)';
      recs.push('Gunakan penanda sebab-akibat semasa menerangkan kesan jangka panjang.');
    } else if (p.m3.completed && calcOverallScore(student) >= 80) {
      mode = 'Pengayaan (Cabaran KBAT Tinggi)';
      recs.push('Cabaran Pengayaan: Bandingkan kesan jangka pendek & panjang dalam hujah anda di Misi 4.');
    }
    if (p.m3.completed && !p.m4.completed) nextStep = 'Seterusnya: Masuk Makmal Suara (Misi 4) dan rakam hujah anda.';
    else if (p.m4.completed && !p.m5.submitted) nextStep = 'Seterusnya: Lancarkan Kempen Digital Selamatkan EcoWorld (Misi 5).';
    else if (p.m5.submitted) nextStep = 'Tahniah! Layari Hall of Heroes untuk mencetak sijil anda.';
  }
  return { levelMode: mode, nextStep, recommendations: recs, needsIntervention: (p.m1.completed && p.m1.score < 60) || (calcOverallScore(student) > 0 && calcOverallScore(student) < 60) };
}

function evaluateBadges(s) {
  const p = s.progress; const e = new Set(s.badges || []);
  if (p.m1.completed && p.m1.score >= 70 && p.m2.completed && p.m2.score >= 70) e.add('eco_explorer');
  if (p.m1.completed && p.m1.score >= 80) e.add('listening_detective');
  if (p.m2.completed && p.m2.score >= 75 && p.m3.completed && p.m3.score >= 75) e.add('critical_thinker');
  if (p.m4.completed && p.m4.score >= 70) e.add('brilliant_speaker');
  if (p.m5.submitted && calcOverallScore(s) >= 70) e.add('eco_hero');
  s.badges = Array.from(e);
}

